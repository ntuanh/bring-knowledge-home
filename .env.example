# Copy this file to .env and fill in the values. .env is ignored by git.

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Leave empty to run without the "Explain with AI" feature.
GEMINI_API_KEY=

# Gemini model used for explanations. Leave empty to use the built-in default.
# If the model is not available for your key, the server lists the models your
# key can use and falls back to a "flash" model.
GEMINI_MODEL=

# TCP port for the visualizer. Leave empty to pick the first free port in 8100-8999.
PORT=

# Optional trusted compiler adapter registry (JSON array). See docs/compiler-adapters.md.
# Use an absolute path. Built-in compilers work without this setting.
COMPILER_ADAPTERS=
